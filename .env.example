# ============================================================
# AI CUSTOMER SUPPORT PLATFORM ENVIRONMENT VARIABLES
# ============================================================

# --- Application ---
APP_NAME="AI Customer Support Platform"
APP_ENV=development
DEBUG=True
LOG_LEVEL=INFO
PORT=8000

# --- Security & Auth ---
JWT_SECRET_KEY=replace-this-with-a-secure-random-secret-key-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Database (PostgreSQL) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=customer_support_db
POSTGRES_HOST=localhost
POSTGRES_PORT=55432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:55432/customer_support_db

# --- Vector Database (ChromaDB) ---
CHROMA_HOST=localhost
CHROMA_PORT=8101
CHROMA_PERSIST_DIRECTORY=.chroma

# --- Google Gemini AI ---
GOOGLE_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_LLM_MODEL=gemini-1.5-pro
GEMINI_VISION_MODEL=gemini-1.5-flash
GEMINI_EMBEDDING_MODEL=models/text-embedding-004

# --- Storage ---
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=20

# --- RAG Settings ---
RETRIEVAL_TOP_K=5
RETRIEVAL_SCORE_THRESHOLD=0.7
