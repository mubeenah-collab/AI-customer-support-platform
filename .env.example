# ============================================================
# AI CUSTOMER SUPPORT PLATFORM
# Azure Production & Development Environment Configuration (.env.example)
# ============================================================

# ------------------------------------------------------------
# 1. BACKEND CONFIGURATION (FastAPI - Azure App Service)
# ------------------------------------------------------------

# Application Environment ('production' | 'development' | 'testing')
APP_NAME="AI Customer Support Platform API"
APP_ENV=production
DEBUG=false
LOG_LEVEL=INFO
PORT=8000

# Security & Authentication
# Generating a production key: `openssl rand -hex 32`
SECRET_KEY=replace-this-with-a-64-character-random-hex-string-in-production
JWT_SECRET_KEY=replace-this-with-a-64-character-random-hex-string-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Allowed Origins (Comma-separated list of allowed frontend origins)
ALLOWED_ORIGINS=https://swa-ai-customer-support.azurestaticapps.net,http://localhost:3100

# PostgreSQL Database (Azure Database for PostgreSQL Flexible Server)
# Format: postgresql+asyncpg://psqladmin:<password>@psql-ai-customer-support.postgres.database.azure.com:5432/customer_support_db?sslmode=require
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/customer_support_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=customer_support_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Vector Database (ChromaDB on Azure App Service Persistent Storage)
CHROMA_USE_HTTP_CLIENT=false
CHROMA_PERSIST_DIRECTORY=/home/site/data/chroma
CHROMA_HOST=localhost
CHROMA_PORT=8000

# Google Gemini AI (Google AI Studio Key)
GOOGLE_API_KEY=your_google_gemini_api_key_here
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_LLM_MODEL=gemini-2.5-pro
GEMINI_VISION_MODEL=gemini-2.5-pro
GEMINI_EMBEDDING_MODEL=models/text-embedding-004

# File Upload Storage (Azure App Service Persistent Storage)
UPLOAD_BASE_DIR=/home/site/data/uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=20

# RAG & Chunking Parameters
RETRIEVAL_TOP_K=5
RETRIEVAL_SCORE_THRESHOLD=0.15

# ------------------------------------------------------------
# 2. FRONTEND CONFIGURATION (React Vite - Azure Static Web Apps)
# ------------------------------------------------------------

# Public Backend API Target URL
# Points to Azure App Service URL in production
VITE_API_URL=https://app-ai-customer-support-backend.azurewebsites.net/api/v1
